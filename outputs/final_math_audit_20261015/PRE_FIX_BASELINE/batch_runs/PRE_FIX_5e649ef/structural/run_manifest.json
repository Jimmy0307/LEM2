{
  "datasets": [
    "Hayes-Roth",
    "Car_Evaluation",
    "Balance_Scale"
  ],
  "config": {
    "input": {
      "mode": "AUTO",
      "local_folder": "./real_data/local",
      "schemas_folder": "./real_data/schemas",
      "uci_sources_file": "./real_data/uci_sources.txt",
      "run_local_files": false,
      "run_uci_sources": true,
      "sheet_name": 0,
      "uci_drop_missing_target": true
    },
    "experiment": {
      "run_centralized": true,
      "run_federated": true,
      "prediction_policy": "FIRST_MATCH"
    },
    "evaluation": {
      "mode": "HOLDOUT",
      "test_ratio": 0.2,
      "cv_folds": 10,
      "seed": 42
    },
    "preprocessing": {
      "auto_discretize": true,
      "unique_numeric_threshold": 10,
      "n_bins": 3
    },
    "federated": {
      "n_clients": 5,
      "partition": "STRATIFIED",
      "dirichlet_alpha": 0.5,
      "dirichlet_max_retries": 100,
