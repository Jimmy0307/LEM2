FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY pyproject.toml FDM_PACKAGE_README.md ./
COPY src/ ./src/
RUN python -m pip install --no-cache-dir . && \
    groupadd -g 10001 fdm && useradd -u 10001 -g fdm -M fdm && \
    mkdir -p /outputs && chown -R fdm:fdm /outputs
USER fdm
VOLUME ["/outputs"]
ENTRYPOINT ["fdm"]
CMD ["algorithms"]
